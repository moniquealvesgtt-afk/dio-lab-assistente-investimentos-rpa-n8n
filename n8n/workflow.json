    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\nconst clientes = Array.isArray(body) ? body : body.clientes;\nconst investimentos = $input.all().map(i => i.json);\n\nconst paraNumero = (s) =>\n  Number(String(s).replace(/[^\\d,]/g, '').replace(',', '.'));\n\nconst foco = {\n  Conservador: 'segurança e previsibilidade, com foco em renda fixa',\n  Moderado: 'um equilíbrio entre renda fixa e renda variável',\n  Arrojado: 'maior potencial de retorno, com ênfase em ações e ativos variáveis',\n};\n\nreturn clientes.map(c => {\n  const saldo = paraNumero(c['saldo']);\n  const perfil = c['perfil'];\n  const opcoes = investimentos.filter(i => i.perfil === perfil);\n  const possiveis = opcoes.filter(o => Number(o.minimo) <= saldo);\n\n  const lista = possiveis\n    .map(o => `• ${o.produto} (mínimo R$ ${o.minimo}, rentabilidade ${o.rentabilidade})`)\n    .join('\\n');\n\n  const mensagem = possiveis.length\n    ? `Olá, ${c.nome}! Com seu perfil ${perfil}, buscamos ${foco[perfil]}. Com seu saldo de ${c.saldo}, estas opções estão disponíveis:\\n${lista}`\n    : `Olá, ${c.nome}! Seu saldo atual (${c.saldo}) ainda não alcança o mínimo das opções do perfil ${perfil}. Que tal montar uma reserva até chegar lá?`;\n\n  return { json: { nome: c.nome, email: c.email, perfil, saldo: c.saldo, mensagem } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "b0b885e0-2890-4dfb-9684-24be3aed8b61",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Cliente: {{ $json.nome }}\nPerfil de investidor: {{ $json.perfil }}\nSaldo: {{ $json.saldo }}\n\nOpções de investimento disponíveis para ele:\n{{ $json.mensagem }}\n\nEscreva uma mensagem curta (até 5 linhas), cordial e personalizada, recomendando as opções mais adequadas ao saldo e ao perfil.",
        "options": {
          "systemMessage": "Você é um assistente de investimentos de um banco. Escreva em português do Brasil, com tom amigável e profissional. Não prometa retornos e inclua um aviso breve de que rentabilidade passada não garante resultado futuro. Use apenas as opções fornecidas, sem inventar produtos."
        }
      },
